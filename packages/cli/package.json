{
  "name": "@weekly-git-report/cli",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BINGWU2003/weekly-git-report",
    "directory": "packages/cli"
  },
  "bin": {
    "weekly": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "kolorist": "catalog:",
    "prompts": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/prompts": "catalog:",
    "@weekly-git-report/core": "workspace:*",
    "@weekly-git-report/shared": "workspace:*",
    "@weekly-git-report/typescript-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
