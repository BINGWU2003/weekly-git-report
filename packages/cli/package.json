{
  "name": "@weekly-git-report/cli",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "weekly": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@weekly-git-report/core": "workspace:*",
    "@weekly-git-report/shared": "workspace:*"
  },
  "devDependencies": {
    "@weekly-git-report/eslint-config": "workspace:*",
    "@weekly-git-report/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
