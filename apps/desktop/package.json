{
  "name": "@weekly-git-report/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Weekly Git Report desktop application.",
  "author": "BINGWU2003",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "check-types:node": "tsc --noEmit -p tsconfig.node.json",
    "check-types:renderer": "tsc --noEmit -p tsconfig.app.json",
    "check-types": "pnpm run check-types:node && pnpm run check-types:renderer",
    "build": "pnpm run check-types && electron-vite build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@electron-toolkit/utils": "catalog:desktop",
    "@hookform/resolvers": "catalog:desktop",
    "@radix-ui/react-alert-dialog": "catalog:desktop",
    "@radix-ui/react-avatar": "catalog:desktop",
    "@radix-ui/react-checkbox": "catalog:desktop",
    "@radix-ui/react-collapsible": "catalog:desktop",
    "@radix-ui/react-dialog": "catalog:desktop",
    "@radix-ui/react-direction": "catalog:desktop",
    "@radix-ui/react-dropdown-menu": "catalog:desktop",
    "@radix-ui/react-icons": "catalog:desktop",
    "@radix-ui/react-label": "catalog:desktop",
    "@radix-ui/react-popover": "catalog:desktop",
    "@radix-ui/react-radio-group": "catalog:desktop",
    "@radix-ui/react-scroll-area": "catalog:desktop",
    "@radix-ui/react-select": "catalog:desktop",
    "@radix-ui/react-separator": "catalog:desktop",
    "@radix-ui/react-slot": "catalog:desktop",
    "@radix-ui/react-switch": "catalog:desktop",
    "@radix-ui/react-tabs": "catalog:desktop",
    "@radix-ui/react-tooltip": "catalog:desktop",
    "@tailwindcss/vite": "catalog:desktop",
    "@tanstack/react-query": "catalog:desktop",
    "@tanstack/react-router": "catalog:desktop",
    "@tanstack/react-table": "catalog:desktop",
    "@weekly-git-report/core": "workspace:*",
    "@weekly-git-report/shared": "workspace:*",
    "@weekly-git-report/workflow": "workspace:*",
    "class-variance-authority": "catalog:desktop",
    "clsx": "catalog:desktop",
    "cmdk": "catalog:desktop",
    "date-fns": "catalog:desktop",
    "electron-log": "catalog:desktop",
    "electron-updater": "^6.8.9",
    "input-otp": "catalog:desktop",
    "lucide-react": "catalog:desktop",
    "react": "catalog:desktop",
    "react-day-picker": "catalog:desktop",
    "react-dom": "catalog:desktop",
    "react-hook-form": "catalog:desktop",
    "react-markdown": "catalog:desktop",
    "react-top-loading-bar": "catalog:desktop",
    "remark-gfm": "catalog:desktop",
    "sonner": "catalog:desktop",
    "tailwind-merge": "catalog:desktop",
    "tailwindcss": "catalog:desktop",
    "tw-animate-css": "catalog:desktop",
    "zod": "catalog:desktop"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "catalog:desktop",
    "@tanstack/react-router-devtools": "catalog:desktop",
    "@tanstack/router-plugin": "catalog:desktop",
    "@types/node": "catalog:desktop",
    "@types/react": "catalog:desktop",
    "@types/react-dom": "catalog:desktop",
    "@vitejs/plugin-react": "catalog:desktop",
    "@vitest/browser-playwright": "catalog:desktop",
    "@vitest/coverage-v8": "catalog:desktop",
    "code-inspector-plugin": "catalog:desktop",
